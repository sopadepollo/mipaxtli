# Datos y modelos: nunca al repositorio.
data/*
!data/.gitkeep

# assets/signs/ SE VERSIONA: son esqueletos de pocos KB renderizados desde el
# dataset propio, y el test del manifest (tests/test_signs_manifest.py) los
# necesita para exigir el criterio de la Fase 4 en CI.

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Entorno
.env

# Artefactos de descarga de Windows (alternate data streams de NTFS).
# Sin los dos puntos: WSL no guarda un ':' ASCII en el nombre sino U+F03A del
# area privada Unicode, asi que un patron con ':' no casa con nada.
*Zone.Identifier

# Andamiaje de ejecucion por subagentes: ledger, briefs e informes.
.superpowers/
