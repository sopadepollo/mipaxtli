# Copiar a .env y ajustar. Ninguna de estas variables es obligatoria: el proyecto
# funciona con los valores por defecto y con config.yaml.
#
# Nada aqui es un secreto ni una credencial: el procesamiento es local y el
# sistema no habla con ningun servicio externo por diseno (ARQUITECTURA.md 4.11).

# Ruta del archivo de configuracion de umbrales.
LSM_CONFIG=config.yaml

# Indice de la camara para las fases posteriores. 0 es la webcam por defecto;
# en Linux corresponde a /dev/video0.
LSM_CAMERA_INDEX=0

# Nivel de logging: DEBUG, INFO, WARNING, ERROR.
LSM_LOG_LEVEL=INFO
